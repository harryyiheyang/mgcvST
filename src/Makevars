CXX_STD = CXX17

# The dense kernels of the pair tests (la_kernel.cpp) are compiled once per
# instruction set and chosen at run time (la_dispatch.h): the ordinary flags
# everywhere, plus AVX2+FMA and AVX-512 copies on x86-64.
SPDEST_ARCH := $(shell uname -m 2>/dev/null)
ifneq ($(filter x86_64 amd64 AMD64,$(SPDEST_ARCH)),)
LA_OBJECTS = la_generic.o la_avx2.o la_avx512.o
LA_DEFS = -DSPDEST_LA_X86
else
LA_OBJECTS = la_generic.o
LA_DEFS =
endif

OBJECTS = RcppExports.o adjust_pvalues.o sparse_score.o compact_units.o \
  memory_status.o nb_null.o pca_learning.o score_pair.o spa_pair.o spa_quadform.o spde_scan.o spde_estimate.o \
  $(LA_OBJECTS)
PKG_CPPFLAGS = $(LA_DEFS)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all
all: $(SHLIB)

# The users of the function table are rebuilt when its layout changes.
score_pair.o pca_learning.o: la_dispatch.h

la_generic.o: la_kernel.cpp la_dispatch.h
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -DSPDEST_LA_ISA=generic -c la_kernel.cpp -o $@
la_avx2.o: la_kernel.cpp la_dispatch.h
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -mavx2 -mfma -DSPDEST_LA_ISA=avx2 -c la_kernel.cpp -o $@
la_avx512.o: la_kernel.cpp la_dispatch.h
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -mavx2 -mfma -mavx512f -mavx512dq -mavx512vl -mavx512bw -DSPDEST_LA_ISA=avx512 -c la_kernel.cpp -o $@
